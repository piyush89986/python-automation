# ==========================================
# Application & Environment Settings
# ==========================================
APP_NAME="Multi-Tenant AI Chatbot Backend"
APP_ENV="development" # development | staging | production
DEBUG=true
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://instabotfr.vercel.app"

# ==========================================
# Database (PostgreSQL with asyncpg)
# ==========================================
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/instabot_db"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# ==========================================
# Redis (Cache, Rate Limiting & Background Queue)
# ==========================================
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# ==========================================
# Security & JWT Authentication
# ==========================================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY="replace_with_a_secure_random_64_character_hex_secret_key"
JWT_REFRESH_SECRET_KEY="replace_with_another_secure_random_hex_secret_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
# Fernet 32-byte urlsafe base64 key for encrypting platform tokens at rest:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY="replace_with_valid_fernet_key_base64_32bytes="

# ==========================================
# AI Providers (OpenAI primary + Gemini fallback)
# ==========================================
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS=1536

GEMINI_API_KEY="..."
GEMINI_MODEL="gemini-2.0-flash"

LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2

# ==========================================
# Vector Database (Pinecone)
# ==========================================
PINECONE_API_KEY="..."
PINECONE_INDEX_NAME="chatbot-kb"
PINECONE_ENVIRONMENT="us-east-1"
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.72

# ==========================================
# Meta Graph API (Instagram & WhatsApp)
# ==========================================
META_APP_ID="..."
META_APP_SECRET="..."
META_WEBHOOK_VERIFY_TOKEN="custom_webhook_secret_verification_token"
META_GRAPH_API_VERSION="v21.0"
META_GRAPH_API_BASE="https://graph.facebook.com"

# ==========================================
# Super Admin Initial Bootstrap (Phase 2)
# ==========================================
FIRST_SUPER_ADMIN_EMAIL="superadmin@example.com"
FIRST_SUPER_ADMIN_PASSWORD="SuperSecurePassword123!"
